# Copy this file to .env and fill in values as needed.
# Choose "sentence_transformers" (free, local, default) or "openai"
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 384 for all-MiniLM-L6-v2 (default). Use 1536 if you switch to OpenAI text-embedding-3-small.
VECTOR_DIM=384
INDEX_PATH=storage/faiss.index
METADATA_PATH=storage/metadata.pkl

TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_FINAL=5

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

MAX_CONTEXT_TOKENS=3000

# Required for generation (OpenAILLM) and if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
